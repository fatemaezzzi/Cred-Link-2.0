# CredLink Backend Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git or expose keys to client bundles.

PORT=5000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Frontend Allowed Origin for CORS
FRONTEND_URL=https://cred-link.vercel.app

# Veramo NIT Demo Issuer Signing Key (Server-side secret, do not commit real keys)
ISSUER_DID=did:key:your-issuer-did
ISSUER_KEY_ID=your-issuer-key-id
ISSUER_PRIVATE_KEY_HEX=your-issuer-private-key-hex
